{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-I${workspaceFolder}/include",
        "${workspaceFolder}/src/main.cpp",
        "-o",
        "${workspaceFolder}/main"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Executar projeto",
      "type": "shell",
      "command": "${workspaceFolder}/main",
      "dependsOn": "Compilar projeto C++",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}